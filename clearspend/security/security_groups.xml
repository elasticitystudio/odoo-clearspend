<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CATÉGORIE DE MODULE -->
    <!-- ============================================ -->
    <record id="module_category_clearspend" model="ir.module.category">
        <field name="name">ClearSpend</field>
        <field name="description">Gestion des abonnements et dépenses SaaS</field>
        <field name="sequence">50</field>
    </record>
    
    <!-- ============================================ -->
    <!-- GROUPES DE SÉCURITÉ -->
    <!-- ============================================ -->
    
    <!-- Utilisateur : voit uniquement son département -->
    <record id="group_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_clearspend"/>
        <field name="comment">Peut voir et créer des abonnements/factures dans son département uniquement.</field>
    </record>
    
    <!-- Manager : gère son département -->
    <record id="group_manager" model="res.groups">
        <field name="name">Manager Département</field>
        <field name="category_id" ref="module_category_clearspend"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="comment">Peut valider les abonnements et gérer les budgets de son département.</field>
    </record>
    
    <!-- CFO/Admin : accès complet -->
    <record id="group_cfo" model="res.groups">
        <field name="name">CFO / Administrateur</field>
        <field name="category_id" ref="module_category_clearspend"/>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
        <field name="comment">Accès complet à tous les départements, configuration et rapports.</field>
    </record>
    
    <!-- ============================================ -->
    <!-- GROUPE MODE AVANCÉ (assigné dynamiquement) -->
    <!-- ============================================ -->
    
    <!-- Ce groupe est assigné/retiré automatiquement à TOUS les utilisateurs
         quand le CFO change le mode dans Configuration > Paramètres.
         Il contrôle la visibilité des menus et fonctionnalités avancées. -->
    <record id="group_advanced_mode" model="res.groups">
        <field name="name">🔵 Mode Avancé</field>
        <field name="category_id" ref="module_category_clearspend"/>
        <field name="comment">Groupe technique assigné automatiquement quand le mode Avancé est activé. Donne accès aux fonctionnalités avancées : Workflow, Prévisions, Intégrations API, OCR, Contrats.</field>
    </record>
    
    <!-- ============================================ -->
    <!-- RÈGLES D'ACCÈS - ABONNEMENTS -->
    <!-- ============================================ -->
    
    <!-- Utilisateurs : voient les abonnements de leur département -->
    <record id="rule_subscription_user" model="ir.rule">
        <field name="name">Abonnements : Mon département</field>
        <field name="model_id" ref="model_clearspend_subscription"/>
        <field name="domain_force">[
            '|',
            ('department_id', '=', False),
            '|',
            ('department_id.member_ids', 'in', [user.id]),
            ('department_id.manager_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- CFO : accès complet aux abonnements -->
    <record id="rule_subscription_cfo" model="ir.rule">
        <field name="name">Abonnements : Accès complet CFO</field>
        <field name="model_id" ref="model_clearspend_subscription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_cfo'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
