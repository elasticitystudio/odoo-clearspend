<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="clearspend.ChartsTemplate">
        <div class="clearspend-charts-wrapper">
            <div class="clearspend-charts-container">
                
                <!-- Header -->
                <div class="clearspend-charts-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-0">📊 Analyses Graphiques</h1>
                            <p class="text-muted mb-0" style="color: rgba(255,255,255,0.8) !important;">Visualisation interactive de vos dépenses SaaS</p>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-light" t-on-click="refreshData">
                                🔄 Actualiser
                            </button>
                            <button class="btn btn-light" t-on-click="goToDashboard">
                                🎛️ Cockpit
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Loading -->
                <t t-if="state.loading">
                    <div class="clearspend-charts-loading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <p class="mt-3 text-muted">Chargement des données...</p>
                    </div>
                </t>
                
                <!-- Error -->
                <t t-elif="state.error">
                    <div class="alert alert-danger m-4">
                        <h5>❌ Erreur</h5>
                        <p t-esc="state.error"/>
                        <button class="btn btn-danger" t-on-click="refreshData">Réessayer</button>
                    </div>
                </t>
                
                <!-- Charts -->
                <t t-else="">
                    <div class="clearspend-charts-content">
                        
                        <!-- KPIs Summary -->
                        <div class="row mb-4" t-if="state.data">
                            <div class="col-md-3 col-6 mb-3">
                                <div class="clearspend-kpi-card" style="border-left: 4px solid #3eb8a5;">
                                    <div class="kpi-value" t-esc="state.data.kpis.total_monthly.toLocaleString('fr-FR')"/>
                                    <div class="kpi-label">€/mois</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="clearspend-kpi-card" style="border-left: 4px solid #1e3d5c;">
                                    <div class="kpi-value" t-esc="state.data.kpis.total_yearly.toLocaleString('fr-FR')"/>
                                    <div class="kpi-label">€/an</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="clearspend-kpi-card" style="border-left: 4px solid #5fcfbc;">
                                    <div class="kpi-value" t-esc="state.data.kpis.subscription_count"/>
                                    <div class="kpi-label">Abonnements</div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <div class="clearspend-kpi-card" style="border-left: 4px solid #2d5a87;">
                                    <div class="kpi-value"><t t-esc="state.data.kpis.finops_score"/>/100</div>
                                    <div class="kpi-label">Score FinOps</div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Row 1: Evolution + Categories -->
                        <div class="row mb-4">
                            <div class="col-lg-8 col-12 mb-4">
                                <div class="clearspend-chart-card">
                                    <h5>📈 Évolution des coûts (6 derniers mois)</h5>
                                    <div class="chart-container" style="height: 300px;">
                                        <canvas t-ref="evolutionChart"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-4">
                                <div class="clearspend-chart-card">
                                    <h5>🎯 Par priorité (€)</h5>
                                    <div class="chart-container" style="height: 300px;">
                                        <canvas t-ref="categoryChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Row 2: Providers + Cycles -->
                        <div class="row mb-4">
                            <div class="col-lg-7 col-12 mb-4">
                                <div class="clearspend-chart-card">
                                    <h5>🏢 Top 10 Fournisseurs</h5>
                                    <div class="chart-container" style="height: 350px;">
                                        <canvas t-ref="providersChart"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 col-12 mb-4">
                                <div class="clearspend-chart-card">
                                    <h5>🔄 Répartition par cycle</h5>
                                    <div class="chart-container" style="height: 350px;">
                                        <canvas t-ref="cycleChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </t>
                
            </div>
        </div>
    </t>
    
</templates>
