<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue du wizard d'import -->
    <record id="view_import_wizard_form" model="ir.ui.view">
        <field name="name">clearspend.import.wizard.form</field>
        <field name="model">clearspend.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer des abonnements">
                <field name="state" invisible="1"/>
                <field name="file_type" invisible="1"/>
                
                <!-- ÉTAPE 1: UPLOAD -->
                <group invisible="state != 'upload'">
                    <div class="alert alert-info text-center" role="alert">
                        <strong>Importez vos abonnements depuis un fichier</strong><br/>
                        <small>Formats supportés : PDF (factures), Excel (.xlsx), CSV</small>
                    </div>
                    
                    <group>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    
                    <div class="text-center mt-3">
                        <button name="action_download_template" type="object" 
                                string="Télécharger le template CSV" class="btn-link"/>
                    </div>
                </group>
                
                <!-- ÉTAPE 2: MAPPING CSV/EXCEL -->
                <group invisible="state != 'mapping'">
                    <div class="alert alert-success" role="alert">
                        <strong>Fichier analysé !</strong> 
                        <field name="preview_count" class="oe_inline"/> lignes détectées.
                    </div>
                    
                    <group string="Mapping des colonnes">
                        <group>
                            <field name="col_name"/>
                            <field name="col_provider"/>
                            <field name="col_price"/>
                            <field name="col_quantity"/>
                            <field name="col_cycle"/>
                        </group>
                        <group>
                            <field name="col_category"/>
                            <field name="col_department"/>
                            <field name="col_renewal"/>
                            <field name="col_notes"/>
                        </group>
                    </group>
                </group>
                
                <!-- ÉTAPE 3: PREVIEW -->
                <group invisible="state != 'preview'">
                    <field name="preview_html" nolabel="1"/>
                </group>
                
                <!-- ÉTAPE PDF: REVIEW -->
                <group invisible="state != 'pdf_review'">
                    <div class="alert alert-info" role="alert">
                        <strong>Données extraites du PDF</strong>
                        <span class="float-end badge bg-primary">
                            Confiance: <field name="ocr_confidence" class="oe_inline"/>%
                        </span>
                    </div>
                    
                    <group>
                        <group string="Informations">
                            <field name="pdf_name"/>
                            <field name="pdf_provider"/>
                            <field name="pdf_provider_id"/>
                            <field name="pdf_invoice_number"/>
                        </group>
                        <group string="Tarification">
                            <field name="pdf_amount"/>
                            <field name="pdf_currency"/>
                            <field name="pdf_cycle"/>
                            <field name="pdf_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Classification">
                            <field name="pdf_category" widget="radio"/>
                            <field name="pdf_department_id"/>
                        </group>
                        <group string="Notes">
                            <field name="pdf_notes"/>
                        </group>
                    </group>
                    
                    <group string="Texte extrait" invisible="not ocr_raw_text">
                        <field name="ocr_raw_text" nolabel="1" readonly="1"/>
                    </group>
                </group>
                
                <!-- RÉSULTAT -->
                <group invisible="state != 'done'">
                    <field name="result_message" nolabel="1"/>
                </group>
                
                <footer>
                    <button name="action_analyze" type="object" string="Analyser" 
                            class="btn-primary" invisible="state != 'upload'"/>
                    
                    <button name="action_back" type="object" string="Retour" 
                            class="btn-secondary" invisible="state not in ('mapping', 'preview', 'pdf_review')"/>
                    <button name="action_preview" type="object" string="Prévisualiser" 
                            class="btn-primary" invisible="state != 'mapping'"/>
                    
                    <button name="action_import" type="object" string="Importer" 
                            class="btn-success" invisible="state != 'preview'"/>
                    
                    <button name="action_import_pdf" type="object" string="Créer l'abonnement" 
                            class="btn-success" invisible="state != 'pdf_review'"/>
                    
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action pour ouvrir le wizard -->
    <record id="action_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer PDF/Excel/CSV</field>
        <field name="res_model">clearspend.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_wizard_form"/>
        <field name="target">new</field>
    </record>
    
    <!-- Bouton dans le menu Actions (engrenage) de la vue liste -->
    <record id="action_server_import_wizard" model="ir.actions.server">
        <field name="name">Importer PDF/Excel/CSV</field>
        <field name="model_id" ref="clearspend.model_clearspend_subscription"/>
        <field name="binding_model_id" ref="clearspend.model_clearspend_subscription"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Importer PDF/Excel/CSV',
    'res_model': 'clearspend.import.wizard',
    'view_mode': 'form',
    'target': 'new',
}
        </field>
    </record>

</odoo>
