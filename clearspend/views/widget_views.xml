<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vue Kanban pour les alertes -->
    <record id="view_alert_kanban" model="ir.ui.view">
        <field name="name">clearspend.alert.kanban</field>
        <field name="model">clearspend.alert</field>
        <field name="arch" type="xml">
            <kanban default_group_by="alert_type" class="o_kanban_small_column">
                <field name="name"/>
                <field name="alert_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="due_date"/>
                <field name="subscription_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.priority.raw_value == '3' ? 'border-danger' : record.priority.raw_value == '2' ? 'border-warning' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong>
                                            <t t-if="record.priority.raw_value == '3'">🔴 </t>
                                            <t t-if="record.priority.raw_value == '2'">🟠 </t>
                                            <t t-if="record.priority.raw_value == '1'">🟡 </t>
                                            <t t-if="record.priority.raw_value == '0'">⚪ </t>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.due_date.raw_value">
                                        <small>📅 <field name="due_date"/></small>
                                    </div>
                                    <div t-if="record.subscription_id.value">
                                        <small class="text-muted">
                                            <field name="subscription_id"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-attf-class="badge #{record.state.raw_value == 'new' ? 'bg-info' : record.state.raw_value == 'seen' ? 'bg-warning' : record.state.raw_value == 'done' ? 'bg-success' : 'bg-secondary'}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vue Kanban pour les recommandations -->
    <record id="view_recommendation_kanban" model="ir.ui.view">
        <field name="name">clearspend.recommendation.kanban</field>
        <field name="model">clearspend.recommendation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="recommendation_type" class="o_kanban_small_column">
                <field name="name"/>
                <field name="recommendation_type"/>
                <field name="potential_savings"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong>💡 <field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div class="text-success" style="font-size: 1.3em;">
                                        <strong><field name="potential_savings"/> €/an</strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <span t-attf-class="badge #{record.state.raw_value == 'new' ? 'bg-info' : record.state.raw_value == 'accepted' ? 'bg-success' : record.state.raw_value == 'done' ? 'bg-primary' : 'bg-secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Raccourci accueil ClearSpend (Kanban par priorité) -->
    <record id="action_clearspend_home" model="ir.actions.act_window">
        <field name="name">🏠 Accueil ClearSpend</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_group_category': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bienvenue dans ClearSpend !
            </p>
            <p>
                Commencez par ajouter vos abonnements SaaS.
            </p>
        </field>
    </record>
    
    <!-- Vue Kanban par statut -->
    <record id="action_subscription_by_state" model="ir.actions.act_window">
        <field name="name">Abonnements par statut</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_group_state': 1
        }</field>
    </record>
    
    <!-- Vue Kanban par fournisseur -->
    <record id="action_subscription_by_provider" model="ir.actions.act_window">
        <field name="name">Abonnements par fournisseur</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_group_provider': 1
        }</field>
    </record>
    
    <!-- Actions rapides -->
    <record id="action_quick_new_subscription" model="ir.actions.act_window">
        <field name="name">➕ Nouvel abonnement</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{
            'default_state': 'draft',
            'default_billing_cycle': 'monthly',
            'default_category': 'important'
        }</field>
    </record>
    
    <record id="action_favorites" model="ir.actions.act_window">
        <field name="name">⭐ Mes favoris</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_favorite', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun favori pour l'instant
            </p>
            <p>
                Cliquez sur ⭐ dans un abonnement pour l'ajouter aux favoris.
            </p>
        </field>
    </record>
    
    <record id="action_upcoming_renewals" model="ir.actions.act_window">
        <field name="name">🔄 Renouvellements proches</field>
        <field name="res_model">clearspend.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[
            ('state', 'in', ['active', 'validated']),
            ('renewal_date', '!=', False),
            ('renewal_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun renouvellement dans les 30 prochains jours
            </p>
            <p>
                Les abonnements avec une date de renouvellement proche apparaîtront ici.
            </p>
        </field>
    </record>
    
    <!-- Action client pour les graphiques interactifs Chart.js -->
    <record id="action_charts_interactive" model="ir.actions.client">
        <field name="name">📊 Graphiques Interactifs</field>
        <field name="tag">clearspend_charts</field>
    </record>
    
</odoo>
