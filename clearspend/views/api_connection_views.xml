<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ============================================ -->
    <!-- CONNEXIONS API - TREE VIEW -->
    <!-- ============================================ -->
    <record id="view_api_connection_tree" model="ir.ui.view">
        <field name="name">clearspend.api.connection.list</field>
        <field name="model">clearspend.api.connection</field>
        <field name="arch" type="xml">
            <list string="Connexions API" decoration-success="state == 'connected'" decoration-danger="state == 'error'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-danger="state == 'error'" decoration-warning="state == 'testing'" decoration-info="state == 'draft'"/>
                <field name="sync_frequency"/>
                <field name="last_sync"/>
                <field name="subscription_count"/>
                <field name="invoice_count"/>
            </list>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- CONNEXIONS API - FORM VIEW -->
    <!-- ============================================ -->
    <record id="view_api_connection_form" model="ir.ui.view">
        <field name="name">clearspend.api.connection.form</field>
        <field name="model">clearspend.api.connection</field>
        <field name="arch" type="xml">
            <form string="Connexion API">
                <header>
                    <button name="action_test_connection" string="🔌 Tester la connexion" type="object" class="btn-primary"/>
                    <button name="action_sync_subscriptions" string="🔄 Synchroniser" type="object" class="btn-secondary" invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="subscription_count" widget="statinfo" string="Abonnements"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Factures"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Connecté" bg_color="bg-success" invisible="state != 'connected'"/>
                    <widget name="web_ribbon" title="Erreur" bg_color="bg-danger" invisible="state != 'error'"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la connexion"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="🔧 Configuration">
                            <field name="provider_type" widget="selection"/>
                            <field name="api_key" password="True"/>
                            <field name="api_secret" password="True" invisible="provider_type not in ('aws',)"/>
                            <field name="api_endpoint" invisible="provider_type != 'custom'"/>
                            <field name="provider_id"/>
                        </group>
                        <group string="⚙️ Synchronisation">
                            <field name="sync_frequency"/>
                            <field name="last_sync"/>
                            <field name="external_customer_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group string="❌ Dernière erreur" invisible="not last_error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                    
                    <notebook>
                        <page string="📖 Guide de configuration">
                            <div class="alert alert-info" role="alert">
                                <h4>Configuration par fournisseur</h4>
                                
                                <h5 class="mt-3">🟣 Stripe</h5>
                                <ol>
                                    <li>Connectez-vous à <a href="https://dashboard.stripe.com" target="_blank">dashboard.stripe.com</a></li>
                                    <li>Allez dans Developers → API Keys</li>
                                    <li>Copiez la "Secret key" (commence par sk_)</li>
                                    <li>Collez-la dans le champ "Clé API"</li>
                                </ol>
                                
                                <h5 class="mt-3">🟠 AWS</h5>
                                <ol>
                                    <li>Connectez-vous à la console AWS</li>
                                    <li>IAM → Users → Créer un utilisateur avec accès Cost Explorer</li>
                                    <li>Copiez l'Access Key ID dans "Clé API"</li>
                                    <li>Copiez le Secret Access Key dans "Secret API"</li>
                                </ol>
                                
                                <h5 class="mt-3">⬛ GitHub</h5>
                                <ol>
                                    <li>Allez dans Settings → Developer settings → Personal access tokens</li>
                                    <li>Générez un nouveau token avec les scopes: read:org, repo</li>
                                    <li>Copiez le token dans "Clé API"</li>
                                </ol>
                            </div>
                        </page>
                        <page string="📊 Données brutes" invisible="not external_data">
                            <field name="external_data" readonly="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- CONNEXIONS API - KANBAN VIEW -->
    <!-- ============================================ -->
    <record id="view_api_connection_kanban" model="ir.ui.view">
        <field name="name">clearspend.api.connection.kanban</field>
        <field name="model">clearspend.api.connection</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="provider_type"/>
                <field name="state"/>
                <field name="last_sync"/>
                <field name="subscription_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-if="record.provider_type.raw_value == 'stripe'">💳 </t>
                                            <t t-if="record.provider_type.raw_value == 'aws'">☁️ </t>
                                            <t t-if="record.provider_type.raw_value == 'gcp'">🔵 </t>
                                            <t t-if="record.provider_type.raw_value == 'github'">⬛ </t>
                                            <t t-if="record.provider_type.raw_value == 'azure'">🔷 </t>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-attf-class="badge #{record.state.raw_value == 'connected' ? 'bg-success' : record.state.raw_value == 'error' ? 'bg-danger' : 'bg-secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div><strong><field name="subscription_count"/></strong> abonnements</div>
                                    <div t-if="record.last_sync.raw_value" class="text-muted">
                                        <small>Sync: <field name="last_sync"/></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- SERVICE OCR - FORM VIEW -->
    <!-- ============================================ -->
    <record id="view_ocr_service_form" model="ir.ui.view">
        <field name="name">clearspend.ocr.service.form</field>
        <field name="model">clearspend.ocr.service</field>
        <field name="arch" type="xml">
            <form string="Service OCR">
                <sheet>
                    <group>
                        <group string="🔍 Configuration OCR">
                            <field name="name"/>
                            <field name="ocr_engine"/>
                            <field name="api_key" password="True" invisible="ocr_engine not in ('google_vision', 'azure_vision')"/>
                        </group>
                        <group string="📊 Statistiques">
                            <field name="total_processed"/>
                            <field name="success_rate" widget="progressbar"/>
                        </group>
                    </group>
                    
                    <div class="alert alert-info mt-3">
                        <h5>💡 Moteurs OCR disponibles</h5>
                        <ul>
                            <li><strong>Extraction basique</strong>: Utilise des regex pour extraire les données des PDFs texte. Gratuit, fonctionne offline.</li>
                            <li><strong>Tesseract OCR</strong>: OCR open-source pour les images/scans. Nécessite l'installation de tesseract-ocr.</li>
                            <li><strong>Google Cloud Vision</strong>: OCR cloud très précis. Nécessite une clé API Google Cloud.</li>
                            <li><strong>Azure Computer Vision</strong>: OCR cloud Microsoft. Format clé: endpoint|api_key</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- ============================================ -->
    <!-- ACTIONS -->
    <!-- ============================================ -->
    <record id="action_api_connection" model="ir.actions.act_window">
        <field name="name">🔌 Connexions API</field>
        <field name="res_model">clearspend.api.connection</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connectez vos fournisseurs SaaS
            </p>
            <p>
                Synchronisez automatiquement vos abonnements depuis Stripe, AWS, GitHub et plus.
            </p>
        </field>
    </record>
    
    <record id="action_ocr_service" model="ir.actions.act_window">
        <field name="name">🔍 Configuration OCR</field>
        <field name="res_model">clearspend.ocr.service</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
</odoo>
