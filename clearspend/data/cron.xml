<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron : Génération automatique des alertes de renouvellement -->
        <record id="cron_generate_renewal_alerts" model="ir.cron">
            <field name="name">ClearSpend : Alertes de renouvellement</field>
            <field name="model_id" ref="model_clearspend_alert"/>
            <field name="state">code</field>
            <field name="code">model.generate_renewal_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Nettoyage des anciennes alertes traitées (> 90 jours) -->
        <record id="cron_cleanup_old_alerts" model="ir.cron">
            <field name="name">ClearSpend : Nettoyage alertes anciennes</field>
            <field name="model_id" ref="model_clearspend_alert"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_alerts()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Mise à jour du badge alertes -->
        <record id="cron_update_alert_badge" model="ir.cron">
            <field name="name">ClearSpend : Mise à jour badge alertes</field>
            <field name="model_id" ref="model_clearspend_alert"/>
            <field name="state">code</field>
            <field name="code">model.update_menu_badge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Analyse des économies (hebdomadaire) -->
        <record id="cron_analyze_savings" model="ir.cron">
            <field name="name">ClearSpend : Analyse des économies</field>
            <field name="model_id" ref="model_clearspend_recommendation"/>
            <field name="state">code</field>
            <field name="code">model.generate_recommendations()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Snapshot mensuel des dépenses -->
        <record id="cron_expense_snapshot" model="ir.cron">
            <field name="name">ClearSpend : Snapshot mensuel</field>
            <field name="model_id" ref="model_clearspend_expense_history"/>
            <field name="state">code</field>
            <field name="code">model.record_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Rapport mensuel par email -->
        <record id="cron_monthly_report_email" model="ir.cron">
            <field name="name">ClearSpend : Rapport mensuel email</field>
            <field name="model_id" ref="model_clearspend_config"/>
            <field name="state">code</field>
            <field name="code">model.send_monthly_report_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Détection anomalies (hebdomadaire) -->
        <record id="cron_detect_anomalies" model="ir.cron">
            <field name="name">ClearSpend : Détection anomalies</field>
            <field name="model_id" ref="model_clearspend_anomaly"/>
            <field name="state">code</field>
            <field name="code">model.detect_all_anomalies()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron : Mise à jour statut contrats (quotidien) -->
        <record id="cron_update_contract_states" model="ir.cron">
            <field name="name">ClearSpend : Mise à jour contrats</field>
            <field name="model_id" ref="model_clearspend_contract"/>
            <field name="state">code</field>
            <field name="code">model.update_contract_states()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron: Synchronisation factures Odoo -->
        <record id="cron_sync_odoo_invoices" model="ir.cron">
            <field name="name">ClearSpend: Sync factures Odoo</field>
            <field name="model_id" ref="model_clearspend_invoice"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_odoo_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        
        <!-- Cron: Synchronisation API fournisseurs -->
        <record id="cron_sync_api_connections" model="ir.cron">
            <field name="name">ClearSpend: Sync APIs fournisseurs</field>
            <field name="model_id" ref="model_clearspend_api_connection"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        
    </data>
</odoo>
